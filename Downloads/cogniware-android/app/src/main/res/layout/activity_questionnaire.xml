<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About You"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This helps us personalise your health monitoring. Your answers never leave your device except when syncing to your clinician."
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Which is your dominant hand?"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <RadioGroup
            android:id="@+id/rg_dominant_hand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rb_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Right"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Left" />

            <RadioButton
                android:id="@+id/rb_ambidextrous"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ambidextrous" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Do you use any mobility aids? (select all that apply)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/cb_cane"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Walking cane or stick" />

        <CheckBox
            android:id="@+id/cb_walker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Walker or rollator" />

        <CheckBox
            android:id="@+id/cb_wheelchair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wheelchair"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Do any of these apply?"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/cb_dominant_hand_disability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Injury, arthritis, or disability in dominant hand" />

        <CheckBox
            android:id="@+id/cb_vision_impairment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Significant vision impairment (beyond corrected vision)" />

        <CheckBox
            android:id="@+id/cb_hearing_impairment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Significant hearing impairment"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Year of Parkinson&#8217;s diagnosis"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Leave blank if unknown or not applicable."
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_diagnosis_year"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_diagnosis_year"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. 2019"
                android:inputType="number"
                android:maxLength="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hoehn &amp; Yahr stage (clinician-assessed)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your neurologist or movement disorder specialist can provide this. Skip if unknown."
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_hy_stage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rb_hy_unknown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unknown / not assessed"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_hy_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stage 1 &#8212; Mild, one side only" />

            <RadioButton
                android:id="@+id/rb_hy_1_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stage 1.5 &#8212; One side + midline involvement" />

            <RadioButton
                android:id="@+id/rb_hy_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stage 2 &#8212; Both sides, balance intact" />

            <RadioButton
                android:id="@+id/rb_hy_2_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stage 2.5 &#8212; Mild bilateral, recovers on pull test" />

            <RadioButton
                android:id="@+id/rb_hy_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stage 3 &#8212; Balance impaired, independent" />

            <RadioButton
                android:id="@+id/rb_hy_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stage 4 &#8212; Severely disabled, can stand unaided" />

            <RadioButton
                android:id="@+id/rb_hy_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stage 5 &#8212; Wheelchair or bedridden" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Primary symptom pattern"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This helps us weight your monitoring signals correctly."
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_symptom_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <RadioButton
                android:id="@+id/rb_symptom_unknown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unknown / not sure"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_tremor_dominant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tremor-dominant &#8212; shaking is the main symptom" />

            <RadioButton
                android:id="@+id/rb_akinetic_rigid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Akinetic-rigid &#8212; slowness/stiffness is the main symptom" />

            <RadioButton
                android:id="@+id/rb_mixed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mixed &#8212; both tremor and slowness/stiffness" />
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Next: Posture Capture" />

    </LinearLayout>
</ScrollView>
