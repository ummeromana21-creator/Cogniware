--- a/recorder.py
+++ b/recorder.py
@@ -0,0 +1,50 @@
+"""recorder.py - per-run spike + group-window recording for trials and experiments.
+
+The recorder binds one fly (the focus fly when the run starts) and the
+hologram's fixed neuron sample. Every step it bit-packs the sample's spikes
+and accumulates firing per named group; every `window` steps it flushes mean
+group rates. finish() returns a JSON-safe dict saved into the record.
+
+Sizes: 2000 sampled neurons x 400 steps = 100 KB -> ~133 KB base64.
+"""
+import base64
+
+import numpy as np
+
+
+class Recorder:
+    def __init__(self, brain, sample_idx, bands, window=25):
+        self.window = int(window) if int(window) > 0 else 25
+        self.sample_idx = np.asarray(sample_idx, dtype=np.int64)
+        self.bands = bands
+        groups = getattr(brain, 'groups', {}) or {}
+        self._masks = {}
+        for k, g in groups.items():
+            idx = np.asarray(g.get('all', []), dtype=np.int64) if isinstance(g, dict) else np.asarray([], dtype=np.int64)
+            if idx.size:
+                self._masks[k] = idx
+        self._gacc = {k: 0.0 for k in self._masks}
+        self.group_rates = {k: [] for k in self._masks}
+        self._n = 0
+        self._steps = []
+
+    def step(self, spiked):
+        s = np.asarray(spiked)
+        self._steps.append(np.packbits(s[self.sample_idx]).tobytes())
+        for k, idx in self._masks.items():
+            self._gacc[k] += float(s[idx].mean())
+        self._n += 1
+        if self._n % self.window == 0:
+            for k in self._gacc:
+                self.group_rates[k].append(self._gacc[k] / self.window)
+                self._gacc[k] = 0.0
+
+    def finish(self):
+        if self._n % self.window:
+            d = self._n % self.window
+            for k in self._gacc:
+                self.group_rates[k].append(self._gacc[k] / d)
+        blob = b''.join(self._steps)
+        return {'window': self.window, 'steps': self._n, 'n_sample': int(self.sample_idx.size),
+                'bands': self.bands, 'spikes_b64': base64.b64encode(blob).decode('ascii'),
+                'groups': {k: [round(v, 6) for v in vs] for k, vs in self.group_rates.items()}}
