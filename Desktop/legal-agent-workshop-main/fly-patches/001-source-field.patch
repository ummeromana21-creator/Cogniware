+def matches_claim(card, verdict):
+    """One line comparing the verdict with the cited claim, or None without a source."""
+    src = card.get('source')
+    if not src:
+        return None
+    direction, citation, pred = src['direction'], src['citation'], card['prediction']
+    if verdict == 'SUPPORTED' and pred == direction:
+        return f"Matches the cited claim ({citation}): yes — treatment went {pred}, as claimed."
+    if verdict == 'SUPPORTED':
+        return (f"Matches the cited claim ({citation}): no — the card predicted {pred} and held, "
+                f"but the paper claims {direction}.")
+    if verdict == 'NOT SUPPORTED':
+        return f"Matches the cited claim ({citation}): no — the boxes did not differ as claimed."
+    if verdict == 'MIXED':
+        return (f"Matches the cited claim ({citation}): partly — the sexes differ; "
+                f"see the per-fly verdicts.")
+    return f"Matches the cited claim ({citation}): unclear — the runs did not settle it."
 
 
