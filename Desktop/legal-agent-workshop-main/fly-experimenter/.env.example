# Meta Model API key used by the agent (never commit a filled .env)
MODEL_API_KEY=
# OpenAI-compatible base URL for model calls
MODEL_API_BASE_URL=https://api.meta.ai/v1
# Model that picks every tool call
MODEL_API_MODEL=muse-spark-1.3
# The fly lab's WebSocket address
LAB_URL=ws://localhost:8765
# Verification layer: off until the checks land (Later scope)
VERIFICATION=off
